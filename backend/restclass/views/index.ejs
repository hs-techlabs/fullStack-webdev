<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>rest class</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h2>Quera posts</h2>
    <% for(post of posts) {%>
    <div class="card">
        <h3 class="user">@<%= post.username %></h3>    
        <h4 class="contant"><%= post.content %></h4>
        <a href="http://localhost:8080/posts/<%=post.id%>"> see in detail</a>
        <a href="http://localhost:8080/posts/<%=post.id%>/edit">Edit</a>
    </div>
    <% } %>

    <br>
    <br>
    <a href="http://localhost:8080/posts/new"> enter new post</a>
</body>
</html>